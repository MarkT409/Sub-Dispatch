# Supabase (required for /admin data: jobs, payments, crew)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated Zoho/admin emails allowed into /admin
ADMIN_EMAILS=you@lantanaelectric.com,partner@lantanaelectric.com

# Or allow anyone on your company domain (optional addition)
# ADMIN_EMAIL_DOMAIN=lantanaelectric.com

# Zoho OAuth — Sign in with Zoho (https://api-console.zoho.com/)
# Register a Server-based application. Authorized redirect URI:
#   http://localhost:3000/api/admin/zoho/callback
#   https://YOUR-PRODUCTION-DOMAIN/api/admin/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# US default; use https://accounts.zoho.eu (etc.) if your org is in another DC
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Signs the admin session cookie after Zoho login (any long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Site URL used for OAuth redirect (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets job board sync (service account — share the sheet with the SA email as Viewer)
# https://console.cloud.google.com/ → enable Google Sheets API → create service account → JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Paste the private_key value; keep \n escapes or use real newlines in quotes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_JOB_BOARD_SPREADSHEET_ID=1B7PtBeDfEQinQa2e8XHoQdGEM-lzJLQXheLHqzsWYTk
# Lantana invoices ledger (Gross / Plan / Sqft) — share with the same service account
GOOGLE_INVOICE_SPREADSHEET_ID=1TvXUr9-G82P6b1ZPsuJWOYa2tNFwoXN8DAUhkMKklVU
# Shared secret for Netlify cron → POST /api/admin/sheets/sync
SHEETS_SYNC_SECRET=change-me-to-a-long-random-string

# Web Push (PWA notifications for new board jobs)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@lantanaelectric.com
