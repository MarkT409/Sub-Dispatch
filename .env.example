# Supabase (required for /admin data: jobs, payments, crew)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed into /admin (bootstrapped as role=admin)
ADMIN_EMAILS=you@yourcompany.com,partner@yourcompany.com

# Super admins can manage other admins and always have board write
SUPER_ADMIN_EMAILS=you@yourcompany.com

# Or allow anyone on your company domain (optional addition)
# ADMIN_EMAIL_DOMAIN=yourcompany.com

# Site URL used for OAuth redirect (required in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets job board sync (service account — share the sheet with the SA email as Viewer)
# https://console.cloud.google.com/ → enable Google Sheets API → create service account → JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Paste the private_key value; keep \n escapes or use real newlines in quotes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_JOB_BOARD_SPREADSHEET_ID=1B7PtBeDfEQinQa2e8XHoQdGEM-lzJLQXheLHqzsWYTk
# Lantana invoices ledger (Gross / Plan / Sqft) — share with the same service account
GOOGLE_INVOICE_SPREADSHEET_ID=1TvXUr9-G82P6b1ZPsuJWOYa2tNFwoXN8DAUhkMKklVU
# Shared secret for Netlify cron → POST /api/admin/sheets/sync
SHEETS_SYNC_SECRET=change-me-to-a-long-random-string

# Web Push (PWA notifications for new board jobs)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@lantanaelectric.com

# Google SSO (admin + crew)
# https://console.cloud.google.com/apis/credentials → Create OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
CREW_GOOGLE_CLIENT_ID=
CREW_GOOGLE_CLIENT_SECRET=

# Crew / admin phone login (SMS OTP)
# https://console.twilio.com → Account SID, Auth Token, and a From number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Without Twilio, set to 1 in local/dev to show the code on screen instead of SMS
CREW_PHONE_OTP_DEV=1
# Admin phone → email map (optional bootstrap). Example:
# ADMIN_PHONES=2105550100:you@company.com,5125550199:other@company.com
# Or set phone on each user under Admin → Users after migration 009.
ADMIN_PHONES=

# Email OTP login (admin + crew) — https://resend.com
# Without Resend, set EMAIL_OTP_DEV=1 (or CREW_PHONE_OTP_DEV=1) to show the code on screen
RESEND_API_KEY=
EMAIL_FROM=Sub-Dispatch <noreply@yourdomain.com>
EMAIL_OTP_DEV=1

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
